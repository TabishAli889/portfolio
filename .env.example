# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- MongoDB Atlas -------------------------------------------------------
# Atlas > Connect > Drivers. Include the database name in the path.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority&appName=portfolio"

# --- Auth.js -------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-32-byte-random-string"

# The single admin user. The password is stored ONLY as a bcrypt hash.
# Generate it with: npm run hash:password -- "your-plain-password"
#
# IMPORTANT: in a .env file every "$" in the hash must be backslash-escaped.
# .env values go through variable expansion, so an unescaped "$2b$12$..." is
# silently truncated and every login fails with "invalid credentials".
# In the Vercel dashboard, paste the hash WITHOUT the backslashes.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH="\$2b\$12\$replace.this.with.the.generated.bcrypt.hash.xxxxxxxxxxxxx"

# Canonical URL of the deployment. Required by Auth.js in production.
# Local: http://localhost:3000   Vercel: https://your-domain.vercel.app
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Cloudinary (image + resume PDF uploads) -----------------------------
# Console > Settings > API Keys.
CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Option 1 (default, more secure): signed uploads.
# Requires a key that is allowed to upload. A key you generated yourself must
# be ACTIVATED in the console first - an inactive or restricted key
# authenticates fine and then fails every upload with
# "Request forbidden due to missing permissions (actions=[\"create\"])".
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-api-secret"

# Option 2 (escape hatch): unsigned uploads via an upload preset.
# Set this and API keys are not used for uploading at all. Create it under
# Settings > Upload > Upload presets, with Signing Mode = Unsigned, and set the
# preset's folder, allowed formats and max file size - an unsigned preset can
# be used by anyone who learns the cloud name and preset name, so those
# restrictions are the security boundary.
# CLOUDINARY_UPLOAD_PRESET="portfolio_unsigned"

# --- Gmail SMTP (contact form) -------------------------------------------
# Requires 2FA on the Google account, then an App Password (16 chars).
# https://myaccount.google.com/apppasswords
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
# Where contact-form notifications are delivered (defaults to GMAIL_USER).
#
# Worth using a DIFFERENT address from GMAIL_USER. When Gmail receives a
# message that its own account sent, it recognises it as yours and files it
# under "Sent"/"All Mail" instead of showing it in the Inbox - so the
# notification looks like it never arrived even though delivery succeeded.
# Pointing this at a second address (or any non-Gmail inbox) avoids that.
CONTACT_TO_EMAIL="somewhere-else@example.com"
